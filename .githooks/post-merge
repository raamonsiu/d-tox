#!/usr/bin/env bash
# Clean merge commits get highest(parent versions) + 1. Fast-forwards (even to an existing merge
# commit) are left untouched: see head_is_existing_commit in scripts/version.sh.
[ "${DTOX_SKIP_VERSION_HOOK:-}" = "1" ] && exit 0
exec "$(git rev-parse --show-toplevel)/scripts/version.sh" merged
