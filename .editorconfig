root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = 100
ktlint_code_style = ktlint_official

[*.md]
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = unset
trim_trailing_whitespace = unset
